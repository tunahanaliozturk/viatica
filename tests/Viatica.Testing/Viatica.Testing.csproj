<Project Sdk="Microsoft.NET.Sdk">

  <!--
    What every container-backed test suite shares: one Postgres, Kafka and Valkey per test assembly, a fresh database
    per test class, and a probe that reads what a service put on a topic. A library, not a test project.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Testcontainers.Kafka" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.Redis" />
    <PackageReference Include="xunit.v3.extensibility.core" />
  </ItemGroup>

  <!-- TestTokens mints tokens for the hosts that AddViaticaAuth configures. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Kernel\Viatica.Kernel.Web\Viatica.Kernel.Web.csproj" />
  </ItemGroup>

</Project>
