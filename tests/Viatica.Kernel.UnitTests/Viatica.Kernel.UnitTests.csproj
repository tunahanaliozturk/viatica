<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    The conventions are exercised over HTTP on an in-process TestServer, and the filter translation through the
    real Npgsql provider's SQL generator (ToQueryString needs no database). Relevox is referenced so the
    validation behaviour runs inside a generated pipeline, the way a service host runs it.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Relevox" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kernel\Viatica.Kernel.Web\Viatica.Kernel.Web.csproj" />
    <ProjectReference Include="..\Viatica.Testing\Viatica.Testing.csproj" />
  </ItemGroup>

</Project>
