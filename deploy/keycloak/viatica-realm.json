{
  "realm": "viatica",
  "enabled": true,
  "displayName": "Viatica",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 30,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 3600,
  "roles": {
    "realm": [
      {
        "name": "traveller",
        "description": "Builds trips, checks out, cancels, sees own trips"
      },
      {
        "name": "partner",
        "description": "Manages own hotels or own rental locations and fleet"
      },
      {
        "name": "admin",
        "description": "Reads everything, suspends partners, unpublishes listings"
      }
    ]
  },
  "clients": [
