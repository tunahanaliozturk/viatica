<Project>

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <!-- C# 15 ships with .NET 11. Until GA the compiler calls it preview. -->
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Item conditions are evaluated after every property, so a project's own IsTestProject is visible here. -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
  </ItemGroup>

  <PropertyGroup Label="Repository metadata">
    <Authors>Tunahan Ali Ozturk</Authors>
    <Product>Viatica</Product>
    <RepositoryUrl>https://github.com/tunahanaliozturk/viatica</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

</Project>
