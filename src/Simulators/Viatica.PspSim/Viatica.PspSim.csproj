<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    A test double that plays a card payment provider with a Stripe shaped HTTP API. It is not part of the product, so
    it references nothing from the kernel: its shapes, errors and conventions are meant to look foreign to ours.
    Everything it keeps is in memory.
  -->

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Viatica.PspSim.UnitTests" />
    <InternalsVisibleTo Include="Viatica.PspSim.IntegrationTests" />
    <!-- The Payments integration tests host the sim in process, to stage failures the way a system test would. -->
    <InternalsVisibleTo Include="Viatica.Payments.IntegrationTests" />
  </ItemGroup>

</Project>
