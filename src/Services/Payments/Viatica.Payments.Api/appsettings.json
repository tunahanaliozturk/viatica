{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Viatica": {
    "Api": {
      "SupportedApiVersions": [ "2026-11-01" ]
    },
    "Auth": {
      "Authority": "http://localhost:8080/realms/viatica"
    }
  },
  "Payments": {
    "Provider": {
      "BaseUrl": "http://localhost:8202/",
      "RequestTimeout": "00:00:05",
      "CircuitBreaker": {
        "FailureRatio": 0.5,
        "MinimumThroughput": 10,
        "SamplingDuration": "00:00:30",
        "BreakDuration": "00:00:15"
      }
    },
    "Consumer": {
      "MaxAttempts": 8,
      "RetryDelay": "00:00:00.500",
      "MaxRetryDelay": "00:00:20"
    }
  }
}
