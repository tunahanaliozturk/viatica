    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="Relevox" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Viatica.Stays.Infrastructure\Viatica.Stays.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\Kernel\Viatica.Kernel.Web\Viatica.Kernel.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Viatica.Stays.IntegrationTests" />
  </ItemGroup>

</Project>
